[pull]
	rebase = true
[init]
	defaultBranch = master

[mergetool "fugitive"]
	cmd = vim -f -c \"Gdiff\" \"$MERGED\"
[merge]
	tool = fugitive
;[commit]
;	gpgsign = true
[push]
	autoSetupRemote = true
[core]
	autocrlf = input

